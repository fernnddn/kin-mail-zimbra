[Unit]
Description=KIN Mail Admin Console
Documentation=file:/opt/kin-mail-console/README.md
After=network-online.target kin-mail-privhelperd.service
Wants=network-online.target
# Console stays unprivileged; privileged work goes through privhelperd's Unix socket.
Wants=kin-mail-privhelperd.service

[Service]
Type=simple
User=kin-console
Group=kin-console
WorkingDirectory=/opt/kin-mail-console/backend
EnvironmentFile=-/etc/kin-mail-console/console.env
Environment=PYTHONPATH=/opt/kin-mail-console/backend
Environment=PRIVHELPER_SOCKET=/run/kin-mail/privhelper.sock
ExecStart=/opt/kin-mail-console/venv/bin/python -m kin_console
Restart=on-failure
RestartSec=3

# Hardening - unprivileged; no extra caps
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kin-mail-console /run/kin-mail
ReadOnlyPaths=/etc/kin-mail-console /opt/kin-mail-console /var/log/kin-mail
# Allow listing processes so /api/setup/status can detect an in-flight install.
ProtectProc=default
ProcSubset=all
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
