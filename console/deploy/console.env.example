# KIN Mail Admin Console — environment (installed to /etc/kin-mail-console/console.env)
#
# CONSOLE_PORT is intentionally overridable; default 9443 avoids Zimbra ports
# (25/80/443/465/587/993/7071/…).

CONSOLE_PORT=9443
CONSOLE_BIND=0.0.0.0
CONSOLE_USER=admin

# Privileged helper (Option B) — local Unix socket only
PRIVHELPER_SOCKET=/run/kin-mail/privhelper.sock
PRIVHELPER_LOG=/var/log/kin-mail/privhelper.log
# Real directory under /opt (NOT a symlink into /home). privhelperd uses ProtectHome=true.
KIN_MAIL_DEPLOY_DIR=/opt/kin-mail-deploy
