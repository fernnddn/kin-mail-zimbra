[Unit]
Description=KIN Mail privileged helper daemon (local Unix socket only)
Documentation=file:/opt/kin-mail-console/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/kin-mail-console/backend
EnvironmentFile=-/etc/kin-mail-console/console.env
Environment=PYTHONPATH=/opt/kin-mail-console/backend
Environment=PRIVHELPER_SOCKET=/run/kin-mail/privhelper.sock
Environment=PRIVHELPER_LOG=/var/log/kin-mail/privhelper.log
Environment=KIN_MAIL_DEPLOY_DIR=/opt/kin-mail-deploy
RuntimeDirectory=kin-mail
RuntimeDirectoryMode=0750
ExecStart=/opt/kin-mail-console/venv/bin/python -m kin_privhelper
Restart=on-failure
RestartSec=3

# Full-install is a child of this service. Default KillMode=control-group
# silently killed kin-mail.sh --full-install (and zmsetup) whenever this unit
# restarted - including on-failure auto-restart - with no [FAIL] in the
# transcript. Kill only the daemon; the installer keeps writing the log.
KillMode=process
# Prefer to OOM-kill something else before the install tree.
OOMScoreAdjust=-500

# PrivateTmp is deliberately OFF, and must stay off.
#
# It does two things this daemon cannot survive. First, it gives the unit its
# own MOUNT NAMESPACE: a snapshot of the mount table taken when the unit
# started. privhelperd runs the DRBD failover path, and a mount surviving in
# another namespace keeps the backing device open while findmnt, fuser and
# /proc/*/fd all read clean, so `drbdadm secondary` cannot release it. That is
# the exact fault that blocked this product's failover for days.
#
# Second, the full install is a CHILD of this unit and KillMode=process keeps
# it alive across a restart. 02-prepare-os.sh upgrades the base image, which
# usually includes systemd; the daemon-reexec that follows tears down the
# private tmpfs while the installer is still running inside it. apt then dies
# with `mkstemp /tmp/...: No such file or directory` and `getcwd() failed`,
# and the deploy stops in prepare-os looking like a DNS or mirror fault. Live,
# 7 Sep 2026; the operator had to recreate /tmp by hand to get past it.
#
# The old comment here claimed PrivateTmp gave "network isolation". It does
# not: it is a filesystem namespace and has no bearing on sockets. The daemon
# listens on a Unix socket under /run/kin-mail and nothing here changes that.
PrivateTmp=false
ProtectHome=true
# Ansible (HA orchestration) must not write under /root - ProtectHome makes it RO.
# Do not bind /root/.ssh: maintenance preflight does not use inter-node SSH keys.
Environment=HOME=/var/lib/kin-mail-privhelper
NoNewPrivileges=false
# Root by design (Option B); capabilities left unrestricted for install scripts later.
# Do not add a network ListenStream here.

[Install]
WantedBy=multi-user.target
