# Ansible local inventory / secrets (keep example committed)
ansible/inventory/lab.yml
ansible/inventory/add-host.yml
ansible/inventory/*.local.yml
ansible/**/*.retry
*.retry

# Real hostnames/IPs for a specific deployment (keep .example committed)
