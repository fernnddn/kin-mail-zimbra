*.tgz
*.tar.gz
*.sha256
*.md5
zcs-*/

# --- admin console build deps (dist is committed for appliance bootstrap) ----
console/frontend/node_modules/
console/backend/.venv/
console/**/__pycache__/
console/**/*.pyc
**/__pycache__/
*.pyc


# --- logs and scratch --------------------------------------------------------
*.log
# Deployment/orchestration transcripts pasted in for debugging. These carry
