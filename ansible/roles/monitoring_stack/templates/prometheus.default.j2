# Managed by Ansible role monitoring_stack (KIN Mail built-in monitoring).
# --web.listen-address on loopback: Monitoring is a console tab, never a port.
ARGS="--web.listen-address={{ monitoring_stack_listen }} \
--storage.tsdb.retention.time={{ monitoring_stack_retention }} \
--storage.tsdb.retention.size={{ monitoring_stack_retention_size }} \
--web.enable-lifecycle"
