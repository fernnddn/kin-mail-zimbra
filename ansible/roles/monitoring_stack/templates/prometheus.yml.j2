# Managed by Ansible role monitoring_stack (KIN Mail built-in monitoring).
# Bound to 127.0.0.1 only - the console proxies this; it is never exposed.
global:
  scrape_interval: {{ monitoring_stack_scrape_interval }}
  evaluation_interval: {{ monitoring_stack_scrape_interval }}
  external_labels:
    cluster: kin-mail

scrape_configs:
  # One static_config per node, each carrying its own instance label.
  #
  # This used to be a single target list with a relabel rule that rewrote
  # EVERY instance to this host's name. That was right while the only target
  # was loopback, and silently wrong the moment a second node was added: the
  # mailbox's metrics would arrive labelled as the edge, land on the edge's
  # charts, and the Monitoring tab would draw two machines as one.
  - job_name: node
    static_configs:
{% for node in monitoring_stack_scrape_nodes %}
      - targets: ["{{ node.address }}"]
        labels:
          instance: "{{ node.instance }}"
          role: "{{ node.role | default('edge') }}"
{% endfor %}

  - job_name: prometheus
    static_configs:
      - targets: ["{{ monitoring_stack_listen }}"]
        labels:
          instance: "{{ inventory_hostname }}"
