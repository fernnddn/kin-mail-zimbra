# Managed by Ansible role monitoring_stack (KIN Mail).
[Unit]
Description=KIN Mail flow metrics collector
Documentation=file://{{ monitoring_stack_mailflow_script }}
# Reading the Postfix log and spool is pointless before mail exists, but this
# must not fail the boot if Zimbra is not up yet: the collector writes
# kin_mail_flow_up 0 and the console shows that honestly.
After=network-online.target

[Service]
Type=oneshot
ExecStart={{ monitoring_stack_mailflow_script }} \
  --log {{ monitoring_stack_mailflow_log }} \
  --spool {{ monitoring_stack_mailflow_spool }} \
  --textfile-dir {{ monitoring_stack_textfile_dir }}
Nice=10
IOSchedulingClass=idle
# It reads a log and stats a spool directory. Nothing else.
ProtectSystem=strict
ReadWritePaths={{ monitoring_stack_textfile_dir }}
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
