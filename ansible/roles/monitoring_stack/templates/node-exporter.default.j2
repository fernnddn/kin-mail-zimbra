# Managed by Ansible role monitoring_stack (KIN Mail built-in monitoring).
#
# The textfile collector is what lets this appliance publish metrics of its own
# alongside the machine metrics - mail flow and queue depth come from a small
# collector writing .prom files into that directory.
ARGS="--web.listen-address={{ monitoring_stack_node_exporter_listen }} --collector.textfile.directory={{ monitoring_stack_textfile_dir }}"
