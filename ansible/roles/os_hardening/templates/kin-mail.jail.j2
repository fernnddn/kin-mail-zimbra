# KIN Mail Part A - human-readable spec for /etc/fail2ban/jail.d/kin-mail.conf
# Live writer: install/lib/kin-fail2ban-jails.sh (also /usr/local/sbin/kin-fail2ban-jails).
# Ansible and the ocf:kin:zimbra agent call that script; keep this file in sync.
[DEFAULT]
ignoreip = {{ os_hardening_ignoreip_effective }}
bantime  = 1h
findtime = 10m
maxretry = 8
backend  = auto

[sshd]
enabled = true
port    = ssh
mode    = normal


{% if os_hardening_mailbox_log_stat.stat.exists %}
[zimbra-auth]
enabled  = true
filter   = zimbra-auth
port     = http,https
logpath  = {{ os_hardening_mailbox_log }}
maxretry = 8
findtime = 10m
bantime  = 1h


{% endif %}
{% if os_hardening_nginx_log_stat.stat.exists %}
[zpush-auth]
enabled  = true
filter   = zpush-auth
port     = https
logpath  = {{ os_hardening_nginx_log }}
maxretry = 10
findtime = 10m
bantime  = 1h

{% endif %}
