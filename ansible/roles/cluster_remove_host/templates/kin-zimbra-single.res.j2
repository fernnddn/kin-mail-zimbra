# KIN Mail - single-node DRBD resource after remove-host
# Generated by role cluster_remove_host. Add Host later rewrites this with a
# peer section when a replacement node joins.
#
# NO net{} and NO address: this resource has one host. drbdadm refuses to parse
# a resource that carries network configuration but names only one node -
#
#   /etc/drbd.d/kin-zimbra.res:5: in resource kin-zimbra:
#       Missing section 'on <PEER> { ... }'.
#   resource kin-zimbra: cannot configure network without knowing my peer.
#
# which is what stopped remove-host on 31 Aug 2026, after the retired node had
# already been taken out of Corosync. `protocol` and the after-sb-* policies
# are connection settings and go with the peer; they come back when one does.
#
# Data: {{ drbd_resource_disk }}
# Meta: EXTERNAL on {{ drbd_resource_meta_disk }}
resource {{ drbd_resource_name }} {
  startup {
    wfc-timeout 60;
    degr-wfc-timeout 30;
  }
  disk {
    on-io-error detach;
  }
  on {{ drbd_resource_node_a_name }} {
    device    {{ drbd_resource_device }};
    disk      {{ drbd_resource_disk }};
    meta-disk {{ drbd_resource_meta_disk }};
  }
}
