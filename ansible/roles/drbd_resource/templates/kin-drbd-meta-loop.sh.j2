#!/bin/bash
# Attach DRBD external meta backing file to fixed {{ drbd_resource_meta_disk }} ({{ drbd_resource_name }}).
set -euo pipefail
IMG={{ drbd_resource_meta_img }}
DEV={{ drbd_resource_meta_disk }}

if [[ ! -f "$IMG" ]]; then
  echo "missing meta image: $IMG" >&2
  exit 1
fi

# Already mapped?
cur=$(losetup -j "$IMG" -O NAME -n 2>/dev/null || true)
if [[ -n "$cur" ]]; then
  if [[ "$cur" != "$DEV" ]]; then
    echo "meta image attached to $cur, expected $DEV" >&2
    exit 1
  fi
  exit 0
fi

# Refuse if loop device already holds something else
if losetup "$DEV" >/dev/null 2>&1; then
  echo "$DEV already in use:" >&2
  losetup "$DEV" >&2
  exit 1
fi

losetup "$DEV" "$IMG"

# Same device-settle race class as the DRBD backing-device fix (25 Aug 2026
# live 2vm practice run): this oneshot unit runs on every future stop/start
# of kin-drbd-meta-loop.service (reboot, manual restart), not just once -
# give the device node a few chances to show up before failing the unit.
attempt=0
while [[ ! -b "$DEV" && "$attempt" -lt 5 ]]; do
  attempt=$((attempt + 1))
  sleep 1
done
test -b "$DEV"
losetup -j "$IMG"
