# KIN Mail — production Zimbra DRBD resource (task 2.5)
# Data: {{ drbd_resource_backing_disk | default(drbd_resource_disk) }}
# (LUKS mapper under DRBD when encryption is on; raw partition otherwise)
# Meta: EXTERNAL on {{ drbd_resource_meta_disk }} -> {{ drbd_resource_meta_img }}
# NEVER use meta-disk internal on a populated data device.
resource {{ drbd_resource_name }} {
  protocol {{ drbd_resource_protocol }};
  syncer {
    rate {{ drbd_resource_sync_rate }};
  }
  startup {
    wfc-timeout 60;
    degr-wfc-timeout 30;
  }
  disk {
    on-io-error detach;
  }
  net {
    after-sb-0pri discard-zero-changes;
    after-sb-1pri discard-secondary;
    after-sb-2pri disconnect;
    rr-conflict disconnect;
  }
  on {{ drbd_resource_node_a_name }} {
    device    {{ drbd_resource_device }};
    disk      {{ drbd_resource_backing_disk | default(drbd_resource_disk) }};
    address   {{ drbd_resource_node_a_address }}:{{ drbd_resource_port }};
    meta-disk {{ drbd_resource_meta_disk }};
  }
  on {{ drbd_resource_node_b_name }} {
    device    {{ drbd_resource_device }};
    disk      {{ drbd_resource_backing_disk | default(drbd_resource_disk) }};
    address   {{ drbd_resource_node_b_address }}:{{ drbd_resource_port }};
    meta-disk {{ drbd_resource_meta_disk }};
  }
}
