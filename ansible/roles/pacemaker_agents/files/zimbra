#!/bin/sh
#
# KIN Mail - OCF Resource Agent for Zimbra (zmcontrol wrapper)
#
meta_data() {
	cat <<'META'
<?xml version="1.0"?>
<!DOCTYPE resource-agent SYSTEM "ra-api-1.dtd">
<resource-agent name="zimbra" version="1.3">
<version>1.3</version>
<longdesc lang="en">
Starts/stops/monitors Zimbra Collaboration via zmcontrol.
Run only where /opt/zimbra is mounted on /dev/drbd* (DRBD Primary + Filesystem RA).

Cold start after DRBD promote: slapd is not running. zmcontrol's
isLdapLocal() is false when ldap_url is ldap://127.0.0.1:389 (it only
matches when the URL contains zimbra_server_hostname), so zmcontrol
will not start ldap first and then fails getEnabledServices. This
agent starts /opt/zimbra/bin/ldap and waits until it is ready before
zmcontrol start.

After a successful start (and on stop, before zmcontrol stop) this
agent refreshes fail2ban jails via /usr/local/sbin/kin-fail2ban-jails
so zimbra-auth/zpush-auth track the mounted mailbox logs. On stop it
also waits until the mount backing has no open holders so DRBD demote
is not blocked by leftover log-tailer FDs. A fail2ban hiccup on start
is logged and ignored - it must never fail the OCF start action.
</longdesc>
<shortdesc lang="en">Zimbra zmcontrol wrapper</shortdesc>
<parameters/>
<actions>
<action name="start" timeout="600"/>
<action name="stop" timeout="300"/>
<action name="monitor" timeout="60" interval="30"/>
<action name="meta-data" timeout="5"/>
<action name="validate-all" timeout="20"/>
</actions>
</resource-agent>
META
}

#######################################################################
# Initialization:

: ${OCF_FUNCTIONS_DIR=${OCF_ROOT}/lib/heartbeat}
. ${OCF_FUNCTIONS_DIR}/ocf-shellfuncs

#######################################################################

ZIMBRA_USER=zimbra
ZIMBRA_DIR=/opt/zimbra

zimbra_mount_source() {
	findmnt -n -o SOURCE "${ZIMBRA_DIR}" 2>/dev/null || true
}

zimbra_validate() {
	local src
	if ! findmnt -n "${ZIMBRA_DIR}" >/dev/null 2>&1; then
		ocf_log err "${ZIMBRA_DIR} is not mounted"
		return $OCF_ERR_INSTALLED
	fi
	src=$(zimbra_mount_source)
	case "$src" in
	/dev/drbd*) ;;
	*)
		ocf_log err "${ZIMBRA_DIR} is mounted from ${src:-unknown}, not /dev/drbd*"
		return $OCF_ERR_INSTALLED
		;;
	esac
	if [ ! -x "${ZIMBRA_DIR}/bin/zmcontrol" ]; then
		ocf_log err "${ZIMBRA_DIR}/bin/zmcontrol missing on mounted tree"
		return $OCF_ERR_INSTALLED
	fi
	return $OCF_SUCCESS
}

zimbra_monitor() {
	local out
	[ -x "${ZIMBRA_DIR}/bin/zmcontrol" ] || return $OCF_NOT_RUNNING
	out=$(su - ${ZIMBRA_USER} -c "zmcontrol status" 2>&1) || return $OCF_NOT_RUNNING
	# Fail if any service line is not Running (ignore Host header / blank / Connect noise)
	if printf '%s\n' "$out" | grep -v Running | grep -vE '^Host|^$' | grep -v 'Connect:' | grep -q .; then
		if printf '%s\n' "$out" | grep -q '[[:space:]]Running$'; then
			ocf_log warn "Zimbra not fully Running"
			return $OCF_ERR_GENERIC
		fi
		return $OCF_NOT_RUNNING
	fi
	printf '%s\n' "$out" | grep -q Running || return $OCF_NOT_RUNNING
	return $OCF_SUCCESS
}

zimbra_ldap_status() {
	su - ${ZIMBRA_USER} -c "${ZIMBRA_DIR}/bin/ldap status" >/dev/null 2>&1
}

# zmcontrol will not start slapd when ldap_url is 127.0.0.1 (isLdapLocal=0).
zimbra_ensure_ldap() {
	local i=0
	[ -x "${ZIMBRA_DIR}/bin/ldap" ] || return 0
	if zimbra_ldap_status; then
		return 0
	fi
	ocf_log info "starting local slapd before zmcontrol"
	su - ${ZIMBRA_USER} -c "${ZIMBRA_DIR}/bin/ldap start" || return $OCF_ERR_GENERIC
	while [ $i -lt 30 ]; do
		zimbra_ldap_status && return 0
		sleep 2
		i=$((i + 1))
	done
	ocf_log err "ldap did not become ready after start"
	return $OCF_ERR_GENERIC
}

# mode=mounted: best-effort (must not fail start). mode=unmounted: hard-fail
# when the helper exists so stop cannot claim success with log-tailers still open.
zimbra_fail2ban_jails() {
	local mode="$1" script="/usr/local/sbin/kin-fail2ban-jails" out rc
	if [ ! -x "$script" ]; then
		ocf_log warn "kin-fail2ban-jails missing; skip jail refresh (${mode})"
		return 0
	fi
	if [ "$mode" = "unmounted" ]; then
		out=$("$script" unmounted 2>&1)
		rc=$?
		ocf_log info "fail2ban jails unmounted rc=${rc}: ${out}"
		return $rc
	fi
	out=$(KIN_FAIL2BAN_JAILS_BEST_EFFORT=1 "$script" "$mode" 2>&1) || true
	ocf_log info "fail2ban jails ${mode}: ${out}"
	return 0
}

# Processes we must never signal to free a mount. Killing any of these is
# worse than the fence we are trying to avoid: sbd or pacemaker would take the
# node down anyway, and sshd would take away the way in to fix it.
zimbra_holder_is_protected() {
	pid="$1"
	case "$pid" in '' | *[!0-9]*) return 0 ;; esac
	[ "$pid" -eq 1 ] && return 0
	[ "$pid" -eq "$$" ] && return 0
	[ "$pid" -eq "${PPID:-0}" ] && return 0
	# cat, not a redirect: the shell reports a failed "<file" itself, before
	# the 2>/dev/null on the same line can suppress it, and a pid that exited
	# between fuser and here is completely normal.
	comm=$(cat "${KIN_OCF_PROC_ROOT:-/proc}/${pid}/comm" 2>/dev/null | tr -d '\n')
	case "$comm" in
	systemd | systemd-udevd | udevd | systemd-journal | systemd-journald) return 0 ;;
	sshd | dbus-daemon | dbus-broker | init | kthreadd) return 0 ;;
	multipathd | iscsid | iscsiuio) return 0 ;;
	corosync | corosync-qdevice | pacemakerd | pacemaker-* | crmd | lrmd | sbd) return 0 ;;
	drbdsetup | drbdadm | nsenter) return 0 ;;
	esac
	return 1
}

# Clear whatever is still holding the mount after zmcontrol stop.
#
# Reporting the holders and giving up is not a safe default here. A stop that
# returns an error leaves Pacemaker exactly one option - fence the node - so
# "refuse and let a human look" is really "reset the node, now and on every
# retry". A 2-host pair did that every three minutes for a quarter of an hour
# on 28 Aug 2026, from a single leftover `sleep` owned by zimbra whose working
# directory was inside /opt/zimbra:
#
#   ERROR: /dev/drbd0 still has open holders after stop (checked 20 times)
#   ERROR: holder: /dev/drbd0:  root   kernel mount /opt/zimbra
#   ERROR: holder:              zimbra  4135 ..c.. sleep
#   Result of stop operation for kin-zimbra: error
#   sbd: Received command reset from mail.nisaroti.my.id
#
# Zimbra has already been told to stop by the time we get here, so anything
# still under the mount is a straggler of its own making. TERM first so a
# process with anything to flush can, then KILL what ignores it.
zimbra_release_holders() {
	src="$1"
	pids=$(fuser -m "$src" 2>/dev/null | tr -s ' ' '\n' | grep -E '^[0-9]+$' || true)
	[ -n "$pids" ] || return 1

	targets=""
	for pid in $pids; do
		if zimbra_holder_is_protected "$pid"; then
			ocf_log warn "holder pid ${pid} ($(cat "${KIN_OCF_PROC_ROOT:-/proc}/${pid}/comm" 2>/dev/null)) is cluster or system infrastructure; leaving it alone"
			continue
		fi
		targets="${targets} ${pid}"
	done
	[ -n "$targets" ] || return 1

	for pid in $targets; do
		ocf_log warn "sending TERM to mount holder ${pid} ($(cat "${KIN_OCF_PROC_ROOT:-/proc}/${pid}/comm" 2>/dev/null)) on ${src}"
		kill -TERM "$pid" 2>/dev/null || true
	done

	i=0
	while [ "$i" -lt "${KIN_OCF_HOLDER_TERM_WAIT:-10}" ]; do
		fuser -m "$src" >/dev/null 2>&1 || return 0
		sleep 1
		i=$((i + 1))
	done

	for pid in $targets; do
		if [ -d "${KIN_OCF_PROC_ROOT:-/proc}/${pid}" ]; then
			ocf_log warn "mount holder ${pid} ignored TERM; sending KILL"
			kill -KILL "$pid" 2>/dev/null || true
		fi
	done
	sleep 2
	fuser -m "$src" >/dev/null 2>&1 || return 0
	return 1
}

# After umount/demote, leftover FDs on the mapper keep DRBD attach from
# succeeding on the peer (same failure class as the plain-mount handoff).
zimbra_wait_backing_free() {
	local src retries delay attempt=0
	src=$(zimbra_mount_source)
	[ -n "$src" ] || src=/dev/drbd0
	case "$src" in
	/dev/drbd*|/dev/mapper/*) ;;
	*)
		ocf_log warn "unusual mount source ${src}; holder wait uses it anyway"
		;;
	esac
	if ! command -v fuser >/dev/null 2>&1; then
		ocf_log warn "fuser not installed; skipping open-holder check on ${src}"
		return 0
	fi
	retries="${KIN_OCF_FUSER_RETRIES:-20}"
	delay="${KIN_OCF_FUSER_DELAY:-1}"
	while [ "$attempt" -lt "$retries" ]; do
		if ! fuser -m "$src" >/dev/null 2>&1; then
			ocf_log info "${src} has no open holders"
			return 0
		fi
		attempt=$((attempt + 1))
		sleep "$delay"
	done
	ocf_log warn "${src} still has open holders after stop (checked ${attempt} times)"
	fuser -vm "$src" 2>&1 | while IFS= read -r line; do
		ocf_log warn "holder: ${line}"
	done || true

	# Last resort before returning an error, because returning one here means
	# the node gets fenced.
	if zimbra_release_holders "$src"; then
		ocf_log info "${src} released after clearing leftover holders"
		return 0
	fi

	# Still busy, and we are NOT going to fail the stop for it.
	#
	# This agent's job is to stop Zimbra, and Zimbra is stopped by the time we
	# reach here. Unmounting belongs to kin-fs, which is the next resource to
	# stop in the group and whose force_unmount handling exists for exactly
	# this - it kills what is holding the mount point and unmounts.
	#
	# Returning an error here means kin-fs never gets its turn, because a
	# failed stop leaves Pacemaker one option: fence the node. That is how a
	# leftover `sleep` rebooted a mail node every three minutes on 28 Aug 2026
	# while the resource designed to deal with it sat one step later in the
	# same group, never running.
	#
	# If kin-fs also cannot unmount, kin-fs fails and the escalation happens
	# there - at the layer that owns the mount, after the code written for the
	# job has actually tried.
	ocf_log err "${src} still has open holders after clearing what we safely could"
	fuser -vm "$src" 2>&1 | while IFS= read -r line; do
		ocf_log err "holder: ${line}"
	done || true
	ocf_log warn "reporting stop as successful anyway: Zimbra is stopped, and kin-fs force_unmount owns the unmount from here"
	return 0
}

zimbra_start() {
	local out rc src
	if ! findmnt -n "${ZIMBRA_DIR}" >/dev/null 2>&1; then
		ocf_log err "${ZIMBRA_DIR} is not mounted"
		return $OCF_ERR_INSTALLED
	fi
	src=$(zimbra_mount_source)
	case "$src" in
	/dev/drbd*) ;;
	*)
		ocf_log err "${ZIMBRA_DIR} is mounted from ${src:-unknown}, not /dev/drbd*"
		return $OCF_ERR_INSTALLED
		;;
	esac
	if [ ! -x "${ZIMBRA_DIR}/bin/zmcontrol" ]; then
		ocf_log err "${ZIMBRA_DIR}/bin/zmcontrol missing on mounted tree"
		return $OCF_ERR_INSTALLED
	fi
	if zimbra_monitor; then
		zimbra_fail2ban_jails mounted
		return $OCF_SUCCESS
	fi
	zimbra_ensure_ldap || return $OCF_ERR_GENERIC
	ocf_log info "zmcontrol start"
	out=$(su - ${ZIMBRA_USER} -c "zmcontrol start" 2>&1)
	rc=$?
	ocf_log info "zmcontrol start rc=${rc}: ${out}"
	[ "$rc" -eq 0 ] || return $OCF_ERR_GENERIC
	local i=0
	while [ $i -lt 100 ]; do
		if zimbra_monitor; then
			zimbra_fail2ban_jails mounted
			return $OCF_SUCCESS
		fi
		sleep 5
		i=$((i + 1))
	done
	return $OCF_ERR_GENERIC
}

zimbra_stop() {
	# Drop zimbra/zpush jails before stop so mailbox.log FDs do not keep the
	# DRBD/LUKS backing busy after Filesystem demotes. Hard-fail if the helper
	# is present and reload fails - soft-skip only when the helper is missing.
	if ! zimbra_fail2ban_jails unmounted; then
		ocf_log err "fail2ban jail drop failed; refusing stop so demote cannot race open holders"
		return $OCF_ERR_GENERIC
	fi
	if [ ! -x "${ZIMBRA_DIR}/bin/zmcontrol" ]; then
		zimbra_wait_backing_free || return $OCF_ERR_GENERIC
		return $OCF_SUCCESS
	fi
	if ! zimbra_monitor >/dev/null 2>&1; then
		zimbra_wait_backing_free || return $OCF_ERR_GENERIC
		return $OCF_SUCCESS
	fi
	ocf_log info "zmcontrol stop"
	su - ${ZIMBRA_USER} -c "zmcontrol stop" || true
	local i=0
	while [ $i -lt 24 ]; do
		if ! zimbra_monitor >/dev/null 2>&1; then
			zimbra_wait_backing_free || return $OCF_ERR_GENERIC
			return $OCF_SUCCESS
		fi
		sleep 5
		i=$((i + 1))
	done
	ocf_log err "zimbra did not stop within 120s"
	return $OCF_ERR_GENERIC
}

case $__OCF_ACTION in
meta-data)	meta_data
		exit $OCF_SUCCESS
		;;
start)		zimbra_start;;
stop)		zimbra_stop;;
monitor)	zimbra_monitor;;
validate-all)	zimbra_validate;;
*)		echo "Usage: $0 {start|stop|monitor|validate-all|meta-data}"
		exit $OCF_ERR_UNIMPLEMENTED
		;;
esac
rc=$?
ocf_log debug "${OCF_RESOURCE_INSTANCE} $__OCF_ACTION : $rc"
exit $rc
